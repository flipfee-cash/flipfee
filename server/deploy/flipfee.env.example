# /etc/flipfee/server.env — https://flipfee.cash (Caddy proxies /api/* to 127.0.0.1:5295 with flush_interval -1).
# Secrets are files under /etc/flipfee; nothing secret goes in this file.

FLIPFEE_ENV=production
PORT=5295
HOST=127.0.0.1
SOLANA_CLUSTER=mainnet-beta

# Sign-In With Solana: domain flipfee.cash, URI https://flipfee.cash, chain id mainnet
ALLOWED_ORIGIN=https://flipfee.cash
TRUST_PROXY=1

DB_PATH=/var/lib/flipfee/flipfee.sqlite

# the flipfee program on mainnet (the lead fills it after the deploy; the client's FLIPFEE_PROGRAM_ID otherwise)
# FLIPFEE_PROGRAM_ID=

# a private RPC makes the trade feed production-grade; the public endpoint works with the caps below
# HELIUS_API_KEY=
# RPC_URL=
# TRADES_WS_URL=
# PUMPPORTAL_API_KEY=
TRACK_MAX=60
# on the public endpoint: 2 trade sockets and at most 400 messages/s from them (the noisiest hot coins give way);
# with a private RPC both caps lift by default
# TRADES_CONNS=2
# MSG_BUDGET=400

# the keeper (program/keeper): sweeps, distributes and cranks every registered coin about every 60 s
KEEPER=0
# KEEPER_KEYPAIR_FILE=/etc/flipfee/keeper.json
# KEEPER_PRIORITY_MICROLAMPORTS=20000

LOG_QUIET=0
