# flipfee server. Copy to .env (loaded at start; never commit it). Every value has a dev default unless noted.

# ── network
SOLANA_CLUSTER=mainnet-beta           # mainnet-beta | devnet | localnet (the flipfee program's cluster; pump data is mainnet)
# RPC_URL=https://api.mainnet-beta.solana.com  # chain reads: the flipfee index, eligibility, pump accounts
#                                              # (localnet default http://127.0.0.1:8899; Helius when HELIUS_API_KEY)
# RPC_WS_URL=                                  # default: RPC_URL as ws(s):// (localnet: port + 1)
# TRADES_WS_URL=wss://api.mainnet-beta.solana.com  # logsSubscribe per tracked curve/pool (localnet: RPC_WS_URL)
# HELIUS_API_KEY=                              # optional: Helius for RPC_URL and TRADES_WS_URL
# RPC_MIN_INTERVAL_MS=120                      # pacing of RPC requests (public endpoints answer 429 to bursts)
# PUMPPORTAL_API_KEY=                          # optional; PumpPortal gives launches and migrations (PUMPPORTAL=0: off)
# PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# ── HTTP
PORT=5295
HOST=127.0.0.1
# ALLOWED_ORIGIN=https://flipfee.cash          # CORS + the Sign-In With Solana domain/URI; required in production.
#                                              # dev default: http://127.0.0.1:5197, :5198, :5173 (+ localhost)
# FLIPFEE_ENV=production                       # strict origins, no dev defaults
# TRUST_PROXY=0                                # 1 behind Caddy: client IP = the last X-Forwarded-For hop
# SESSION_HOURS=24
# SIWS_CHAIN_ID=mainnet                        # default by cluster: mainnet | devnet | localnet

# ── storage
# DB_PATH=./data/flipfee-mainnet-beta.sqlite   # production default /var/lib/flipfee/flipfee.sqlite

# ── the flipfee program
# FLIPFEE_PROGRAM_ID=                          # default: the client's FLIPFEE_PROGRAM_ID (its IDL address)
# FLIPFEE_CLIENT=                              # default: ../program/client, then vendor/flipfee-client (npm run vendor)
# INDEX=1  INDEX_POLL_MS=30000  CLIENT_POLL_MS=30000

# ── the keeper (program/keeper; off by default)
# KEEPER=0
# KEEPER_KEYPAIR_FILE=/etc/flipfee/keeper.json # Solana CLI keypair JSON; never printed
# KEEPER_INTERVAL_MS=60000
# KEEPER_PRIORITY_MICROLAMPORTS=0
# FLIPFEE_KEEPER=                              # default: ../program/keeper, then vendor/flipfee-keeper

# ── live data
# TRACK_MAX=60                                 # coins whose trades we follow (registered first, then the hottest)
# HOT_MAX=30                                   # rows in the board's Hot list
# ROTATE_MS=60000  MIN_DWELL_MIN=15  SWAP_MARGIN=1.5  MAX_SWAPS=3   # Hot rotation
# SUBS_PER_SEC=5                               # logsSubscribe messages per second (20 with a private RPC)
# TRADES_CONNS=2                               # trade sockets side by side (1 with a private RPC)
# MSG_BUDGET=400                               # messages/s the trade sockets may bring (0 = no cap; default 0 with a private RPC)
# INGEST=1  TRADES=1  HOT=1  PUMPFUN_API=1     # PUMPFUN_API=0: no pump.fun / DexScreener / Jupiter (localnet default)
# RING_SIZE=2000  SSE_MAX_PER_IP=12
# SSE_TRADES_PER_SEC=25                        # the board's stream: trades of coins off flipfee per client (0 = all)
# LOG_QUIET=0
