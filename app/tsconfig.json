{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "flipfee-client": [
        "../program/client/dist/index.d.ts",
        "./src/chain/client-missing.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "dev/fixturePlugin.ts"
  ]
}
